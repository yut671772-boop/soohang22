:root {
    --primary-color: #2563eb;
    --success-color: #16a34a;
    --danger-color: #dc2626;
    --bg-color: #f8fafc;
    --card-bg: #ffffff;
    --text-color: #1e293b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    padding: 20px;
    max-width: 1200px;
    margin: 0 auto;
}

header {
    text-align: center;
    margin-bottom: 25px;
    background: var(--card-bg);
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

header h1 {
    color: var(--primary-color);
    font-size: 1.8rem;
    margin-bottom: 8px;
}

header p {
    color: #64748b;
    font-size: 0.95rem;
}

.grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
}

.card {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.card h2 {
    font-size: 1.2rem;
    margin-bottom: 15px;
    padding-bottom: 8px;
    border-bottom: 2px solid #f1f5f9;
    color: #334155;
}

.input-group {
    margin-bottom: 12px;
}

.input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 5px;
    color: #475569;
}

input[type="text"], input[type="number"], select {
    width: 100%;
    padding: 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.9rem;
}

button {
    width: 100%;
    padding: 10px 15px;
    border: none;
    border-radius: 6px;
    background-color: var(--primary-color);
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 5px;
}

button:hover {
    opacity: 0.9;
}

button.btn-danger {
    background-color: var(--danger-color);
}

button.btn-success {
    background-color: var(--success-color);
}

.status-badge {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: bold;
    background: #e2e8f0;
    color: #475569;
}

.status-badge.connected {
    background: #dcfce7;
    color: #15803d;
}

#webcam-container, #image-container {
    width: 100%;
    height: 280px;
    background: #1e293b;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
}

#webcam-container canvas, #image-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.prob-bar-container {
    margin-top: 10px;
}

.prob-item {
    margin-bottom: 8px;
}

.prob-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    margin-bottom: 3px;
}

.prob-bar-bg {
    height: 10px;
    background: #e2e8f0;
    border-radius: 5px;
    overflow: hidden;
}

.prob-bar-fill {
    height: 100%;
    background: var(--primary-color);
    width: 0%;
    transition: width 0.2s;
}

#result-display {
    margin-top: 15px;
    padding: 15px;
    border-radius: 8px;
    text-align: center;
    font-size: 1.2rem;
    font-weight: bold;
    background: #f1f5f9;
}

#result-display.right {
    background: #dcfce7;
    color: #16a34a;
}

#result-display.wrong {
    background: #fee2e2;
    color: #dc2626;
}

.log-box {
    height: 120px;
    overflow-y: auto;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 8px;
    font-family: monospace;
    font-size: 0.8rem;
    margin-top: 10px;
}
